<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <PublishProvider>AzureWebSite</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ResourceId>/subscriptions/2c1457ae-3e88-4e2a-b104-b5e4a1fa8780/resourceGroups/LittersoftRG/providers/Microsoft.Web/sites/jobsweeper</ResourceId>
    <SiteUrlToLaunchAfterPublish>https://jobsweeper-eddmccb7gqfyetfp.switzerlandnorth-01.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <PublishUrl>https://jobsweeper-eddmccb7gqfyetfp.scm.switzerlandnorth-01.azurewebsites.net/</PublishUrl>
  </PropertyGroup>
  <ItemGroup>
    <!-- This profile supplies production configuration through Azure settings. -->
    <None Update="appsettings*.json;local.settings.json;Secrets/**/*.json;Properties/PublishProfiles/*.json;Properties/PublishProfiles/*.ps1">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <Target Name="ConfigureJobsweeperEnvironment" BeforeTargets="PrepareForPublish">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/Properties/PublishProfiles/Configure-Jobsweeper.ps1&quot; -Apply" />
  </Target>
</Project>
