  "components": {
    "schemas": {
      "BlockParticipantRequest": {
        "required": [
          "counterpartyId",
          "reason"
        ],
        "type": "object",
        "properties": {
          "counterpartyId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ChatAttachmentPayload": {
        "required": [
          "blobUrl",
          "contentType",
          "sizeBytes",
          "width",
          "height"
        ],
        "type": "object",
        "properties": {
          "blobUrl": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "width": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "height": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "GetBlobImageRequest": {
        "required": [
          "blobUrl"
        ],
        "type": "object",
        "properties": {
          "blobUrl": {
            "type": "string"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "MarkConversationReadRequest": {
        "required": [
          "upToSequence"
        ],
        "type": "object",
        "properties": {
          "upToSequence": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "OpenConversationRequest": {
        "required": [
          "counterpartyId"
        ],
        "type": "object",
        "properties": {
          "counterpartyId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SendMessageRequest": {
        "required": [
          "clientMessageId",
          "kind",
          "text",
          "attachment"
        ],
        "type": "object",
        "properties": {
          "clientMessageId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "kind": {
            "type": [
              "null",
              "string"
            ]
          },
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "attachment": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ChatAttachmentPayload"
              }
            ]
          }
        }
      }
    }
